{% extends '@!WebProfiler/Profiler/layout.html.twig' %}

{% block body %}
<div class="container performance-dashboard">
    <h1>Performance Dashboard</h1>
    
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h2>Métriques globales</h2>
                </div>
                <div class="card-body">
                    <canvas id="performanceChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h2>Problèmes N+1 détectés</h2>
                </div>
                <div class="card-body">
                    <table class="table table-striped" id="nplusoneTable">
                        <thead>
                            <tr>
                                <th>Requête</th>
                                <th>Occurrences</th>
                                <th>Temps total</th>
                                <th>Suggestions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{% include '@AAPerformanceAnalyzer/includes/chartjs.html.twig' %}
{% endblock %}
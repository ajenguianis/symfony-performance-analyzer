{% extends '@SymfonyPerformanceAnalyzer/base.html.twig' %}

{% block body %}
    <div class="container mx-auto p-4">
        <h1 class="text-2xl font-bold mb-4">{{ 'performance_dashboard.title'|trans }}</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for stat in stats %}
                {% component MetricCard with {
                    title: stat.route,
                    value: stat.avgResponseTime|round(2),
                    unit: 'ms',
                    label: 'avg_response_time'|trans
                } %}
                {% endcomponent %}
                
                {% component MetricCard with {
                    title: stat.route,
                    value: (stat.avgMemoryUsage / 1024 / 1024)|round(2),
                    unit: 'MB',
                    label: 'avg_memory_usage'|trans
                } %}
                {% endcomponent %}
                
                {% component MetricCard with {
                    title: stat.route,
                    value: stat.avgQueryCount|round(2),
                    unit: 'queries',
                    label: 'avg_query_count'|trans
                } %}
                {% endcomponent %}
            {% endfor %}
        </div>

        <h2 class="text-xl font-bold mt-8 mb-4">{{ 'recent_logs.title'|trans }}</h2>
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-gray-200">
                    <th class="p-2">{{ 'route'|trans }}</th>
                    <th class="p-2">{{ 'response_time'|trans }}</th>
                    <th class="p-2">{{ 'memory_usage'|trans }}</th>
                    <th class="p-2">{{ 'query_count'|trans }}</th>
                    <th class="p-2">{{ 'created_at'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr class="{% if log.metadata|has_issues %}bg-red-100{% endif %}">
                        <td class="p-2">{{ log.route }}</td>
                        <td class="p-2">{{ log.responseTime }} ms</td>
                        <td class="p-2">{{ (log.memoryUsage / 1024 / 1024)|round(2) }} MB</td>
                        <td class="p-2">{{ log.queryCount }}</td>
                        <td class="p-2">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
{% block javascripts %}
{{ parent() }}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    fetch('{{ path("performance_dashboard_data") }}')
        .then(response => response.json())
        .then(data => {
            // Graphique principal
            const ctx = document.getElementById('performanceChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [
                        {
                            label: data.datasets.response_time.label,
                            data: data.datasets.response_time.data,
                            borderColor: data.datasets.response_time.borderColor,
                            backgroundColor: data.datasets.response_time.backgroundColor,
                            yAxisID: 'y'
                        },
                        {
                            label: data.datasets.query_count.label,
                            data: data.datasets.query_count.data,
                            borderColor: data.datasets.query_count.borderColor,
                            backgroundColor: data.datasets.query_count.backgroundColor,
                            yAxisID: 'y1'
                        },
                        {
                            label: data.datasets.memory_usage.label,
                            data: data.datasets.memory_usage.data,
                            borderColor: data.datasets.memory_usage.borderColor,
                            backgroundColor: data.datasets.memory_usage.backgroundColor,
                            yAxisID: 'y2'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: { display: true, text: 'Temps (ms)' }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Requêtes SQL' }
                        },
                        y2: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Mémoire (MB)' }
                        }
                    }
                }
            });

            // Tableau N+1
            const tableBody = document.querySelector('#nplusoneTable tbody');
            data.nplusone.slice(0, 10).forEach(issue => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><code>${issue.pattern}</code></td>
                    <td>${issue.count}</td>
                    <td>${issue.total_time.toFixed(2)} ms</td>
                    <td>${getSuggestion(issue.pattern)}</td>
                `;
                tableBody.appendChild(row);
            });
        });

    function getSuggestion(pattern) {
        if (pattern.includes('JOIN')) {
            return 'Vérifiez les jointures et utilisez peut-être FETCH JOIN';
        }
        if (pattern.includes('WHERE') && pattern.includes('= ?')) {
            return 'Envisagez un chargement batch des entités';
        }
        return 'Examinez cette requête récurrente';
    }
});
</script>
{% endblock %}
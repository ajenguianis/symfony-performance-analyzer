{% extends '@SymfonyPerformanceAnalyzer/base.html.twig' %}
{% block body %}
	<div class="container mx-auto p-4">
		<h1 class="text-2xl font-bold mb-4">{{ 'performance_report.title'|trans }}</h1>

		<h2 class="text-xl font-bold mt-8 mb-4">{{ 'statistics.title'|trans }}</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			{% for stat in stats %}
				{% component MetricCard with {
                    title: stat.route,
                    value: stat.avgResponseTime|round(2),
                    unit: 'ms',
                    label: 'avg_response_time'|trans
                } %}
				{% endcomponent %}
			{% endfor %}
		</div>

		<h2 class="text-xl font-bold mt-8 mb-4">{{ 'issues_detected.title'|trans }}</h2>
		{% for log in logs %}
			{% if log.metadata|has_issues %}
				{% component AlertComponent with {
    type: 'danger',
    message: 'issues_detected.message'|trans({'%route%': log.route})
} %}
				{% block content %}
					<ul>
						{% for issue in log.metadata.analysis_results|map_issues %}
							<li>{{ issue.message }}
								({{ 'severity'|trans }}:
								{{ issue.severity }})</li>
						{% endfor %}
					</ul>
				{% endblock %}
				{% endcomponent %}
			{% endif %}
		{% endfor %}
	</div>
{% endblock %}
